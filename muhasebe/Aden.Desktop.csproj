<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <StartupObject>Aden.Program</StartupObject>
    <AdenReleaseRepo Condition="'$(AdenReleaseRepo)' == ''">hbaydemir/aden</AdenReleaseRepo>
    <ApplicationIcon>Assets/aden-icon-logo.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../shared/Aden.Core.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.14" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="PDFsharp-MigraDoc-WPF" Version="6.2.4" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <AssemblyMetadata Include="AdenReleaseRepo" Value="$(AdenReleaseRepo)" />
    <Resource Include="Assets/*.png" />
    <EmbeddedResource Include="Migrations/*.sql" />
  </ItemGroup>
</Project>




